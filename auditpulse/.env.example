# ============================================================
# AuditPulse Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- Database -----
# Default: zero-config local SQLite
DATABASE_URL=sqlite+aiosqlite:///./auditpulse.db
DATABASE_SYNC_URL=sqlite:///./auditpulse.db
# For PostgreSQL (e.g. via Docker / Production):
# DATABASE_URL=postgresql+asyncpg://auditpulse:auditpulse_password@localhost:5432/auditpulse
# DATABASE_SYNC_URL=postgresql://auditpulse:auditpulse_password@localhost:5432/auditpulse

# ----- AI Provider (choose one) -----
# Options: groq | openai | anthropic | google | mock
AI_PROVIDER=mock

# Groq (Ultra-Fast Llama-3)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-70b-8192

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-1.5-pro

# ----- App Settings -----
APP_SECRET_KEY=change-this-in-production-to-a-random-secret
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-domain.com

# ----- File Upload -----
MAX_UPLOAD_SIZE_MB=10
ALLOWED_POLICY_EXTENSIONS=.txt,.md,.pdf
ALLOWED_CODE_EXTENSIONS=.js,.ts,.jsx,.tsx,.py,.java,.go

# ----- GitHub Integration -----
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_TOKEN=ghp_...

# ----- Vendor Monitoring -----
VENDOR_CHECK_INTERVAL_HOURS=24
PLAYWRIGHT_HEADLESS=true

